# Pop Tuman Tashkilotlari va INN Tizimi (PRO)
# Muhit Sozlamalari (Environment Configuration Template)
# Ushbu fayl nusxasini olib, nomini '.env' ga o'zgartiring va maxfiy ma'lumotlarni kiriting.

# Telegram Bot API Tokeni
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Sheets Service Account Kalit Fayli Yo'li (ixtiyoriy, standart: service_account.json)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
